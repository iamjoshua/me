---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Lightbox from "@/components/PhotoGallery/Lightbox.astro";
import { getPhotoUrl } from "@/lib/utils";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  const collections = await getCollection("photoCollections");

  // Map each photo to its "home" collection. Prefer any non-favorites
  // collection it appears in; fall back to favorites if that's the only one.
  const nonFavorites = collections.filter((c) => c.id !== "favorites");
  const favoritesOnly = collections.filter((c) => c.id === "favorites");

  const photoIdToCollectionId = new Map<string, string>();
  for (const collection of [...nonFavorites, ...favoritesOnly]) {
    const yamlPhotos = (collection.data.photos ?? []) as Array<{
      path: string;
    }>;
    for (const yp of yamlPhotos) {
      const normalized = yp.path.replace(/^\/+/, "").replace(/^\.+\//, "");
      const withoutPhotosPrefix = normalized.startsWith("photos/")
        ? normalized.substring(7)
        : normalized;
      const photo = photos.find((p) => p.data.path === withoutPhotosPrefix);
      if (photo && !photoIdToCollectionId.has(photo.id)) {
        photoIdToCollectionId.set(photo.id, collection.id);
      }
    }
  }

  return photos.map((photo) => ({
    params: { photo: photo.id },
    props: {
      selectedPhoto: photo,
      homeCollectionId: photoIdToCollectionId.get(photo.id) ?? null,
    },
  }));
}

const { selectedPhoto, homeCollectionId } = Astro.props;

const title = `Joshua Heiland | Photographs | ${selectedPhoto.data.title}`;
const description = `View ${selectedPhoto.data.title} and other photographs by Joshua Heiland`;
const ogImageUrl = getPhotoUrl(selectedPhoto.data.path, { width: 1200 });

const navigateUrl =
  homeCollectionId && homeCollectionId !== "favorites"
    ? `/photography/${homeCollectionId}`
    : "/photography";

const photoData = {
  imageUrl: getPhotoUrl(selectedPhoto.data.path, { width: 2400 }),
  title: selectedPhoto.data.title,
  iso: selectedPhoto.data.iso ? `ISO ${selectedPhoto.data.iso}` : "",
  aperture: selectedPhoto.data.aperture
    ? `f/${selectedPhoto.data.aperture}`
    : "",
  focalLength: selectedPhoto.data.focal_length
    ? `${selectedPhoto.data.focal_length}mm`
    : "",
  shutterSpeed: selectedPhoto.data.shutter_speed || "",
};
---

<Layout title={title}>
  <meta slot="head" property="og:title" content={title} />
  <meta slot="head" property="og:description" content={description} />
  <meta slot="head" property="og:image" content={ogImageUrl} />
  <meta slot="head" property="og:url" content={Astro.url} />
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:image" content={ogImageUrl} />
  <meta slot="head" name="twitter:title" content={title} />
  <meta slot="head" name="twitter:description" content={description} />

  <div data-gallery-navigate-url={navigateUrl}></div>

  <Lightbox />
</Layout>

<script define:vars={{ photoData }}>
  function openOnLoad() {
    const w = window;
    if (typeof w.openLightbox !== "function") {
      requestAnimationFrame(openOnLoad);
      return;
    }
    w.openLightbox(photoData.imageUrl, photoData.title, {
      iso: photoData.iso,
      aperture: photoData.aperture,
      focalLength: photoData.focalLength,
      shutterSpeed: photoData.shutterSpeed,
    });
    const prev = document.getElementById("prev-photo");
    const next = document.getElementById("next-photo");
    if (prev) prev.style.display = "none";
    if (next) next.style.display = "none";
  }
  openOnLoad();
</script>
